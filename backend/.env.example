PORT=3000
DATABASE_URL=postgres://localhost:5432/ninetel
JWT_SECRET=change-me

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_BASE_URL=https://api.9tel.example.com

# Voice SDK (in-app/browser call delivery for users outside US/CA/GB —
# see services/telephony/coverage.ts's usesPstnDestination). These are
# DIFFERENT credentials from the Account SID/Auth Token above: Access
# Tokens must be signed with an API Key, not the account auth token.
# Create both under Twilio Console > Account > API keys & tokens, and a
# TwiML Application (Console > Voice > TwiML Apps) with its Voice URL
# pointed at POST {TWILIO_WEBHOOK_BASE_URL}/api/voice/incoming so
# outgoing calls from the Voice SDK client also route through this app.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=

# SMS delivery for OTP login codes and destination-verification codes
# (services/sms.ts). Must be a Twilio number capable of sending SMS in
# the destination country — does NOT need to be the same number(s)
# provisioned for call forwarding, and in most cases shouldn't be (a
# shared toll-free number may not be SMS/A2P-verified everywhere).
TWILIO_SMS_FROM_NUMBER=

# One shared toll-free number used by every Free-tier user (see
# services/telephony/sharedExtension.ts). Callers dial this number, then
# enter the user's extension. Premium/Business users get their own
# dedicated number instead via TwilioProvider.provisionNumber().
SHARED_TOLLFREE_NUMBER=+18005550100

# Stripe — chosen over Flutterwave given the app's US-first direction
# (USD pricing, US/CA/GB toll-free + Voice SDK split). See
# services/payments/stripe.ts.
STRIPE_SECRET_KEY=
# From Stripe Dashboard > Developers > Webhooks, after adding an endpoint
# for POST {TWILIO_WEBHOOK_BASE_URL}/api/billing/webhook. Used to verify
# incoming webhook requests actually came from Stripe.
STRIPE_WEBHOOK_SECRET=
# Recurring monthly Price IDs created in Stripe Dashboard > Products —
# one per paid plan, matching PLANS in services/payments/stripe.ts
# (Business is a single fixed $29.99/month price, not a range). Free has
# none since it's never checked out.
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_BUSINESS=

# How many inbound 9tel numbers a Business account may hold — the actual
# feature-gating behind Business's higher price (see routes/numbers.ts).
# Free/Premium are hard-capped at 1 in code, not configurable here.
BUSINESS_MAX_NUMBERS=3

# Free-tier limits — sized against US toll-free telephony cost
# (~$3.73/user/month at 45 min, see revenue-feasibility breakdown).
# 15 min keeps free-tier telephony cost near $1.40/user/month.
FREE_TIER_MONTHLY_MINUTES=15
PREMIUM_TIER_MONTHLY_MINUTES=500
BUSINESS_TIER_MONTHLY_MINUTES=2000
